{
  "name": "fk-atc-usage-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://atc.fwdskillzone.com",
    "GOOGLE_CLIENT_ID": "899290626924-a3rjbpp429cf68lentrdvhk4hbfqocj4.apps.googleusercontent.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "fk-atc-usage", "database_id": "cf19685c-88c2-445e-ba8a-67c594b95504" }],
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["0 3 * * *"] }
}
