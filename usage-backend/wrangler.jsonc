{
  "name": "fk-atc-usage",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://atc.fwdskillzone.com",
    "GOOGLE_CLIENT_ID": ""
  },
  "d1_databases": [{ "binding": "DB", "database_name": "fk-atc-usage", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["0 3 * * *"] }
}
